<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarPost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarPost"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/label_post_title"
            app:titleTextColor="@color/colorTextOnDark" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Form -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Step 1 Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Step 1 - Describe your need"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08" />

            <!-- Title Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPostTitle"
                style="@style/Widget.NHN.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/hint_request_title">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPostTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Description Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPostDescription"
                style="@style/Widget.NHN.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:hint="@string/hint_request_description"
                app:counterEnabled="true"
                app:counterMaxLength="400">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPostDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="5"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Step 2 Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="Step 2 - AI Classification"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08" />

            <!-- AI Analyze Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnalyzeAi"
                style="@style/Widget.NHN.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:text="@string/btn_analyze_ai"
                android:textSize="15sp"
                app:strokeColor="@color/colorAccent"
                app:strokeWidth="2dp" />

            <!-- AI Result Card (hidden by default) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAiResult"
                style="@style/Widget.NHN.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/colorAccent"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="AI Analysis Result"
                        android:textColor="@color/colorPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Category -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="Category"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvAiCategory"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="-"
                            android:textColor="@color/colorPrimary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Urgency Level -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="Urgency"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvAiUrgencyLevel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="-"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Score Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="Score"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="12sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressAiScore"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            app:indicatorColor="@color/colorAccent"
                            app:trackColor="#E0E4F0"
                            app:trackCornerRadius="4dp" />

                        <TextView
                            android:id="@+id/tvAiScore"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="0/100"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Tags -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Tags"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12sp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupTags"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Step 3 Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="Step 3 - Submit"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08" />

            <!-- Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitRequest"
                style="@style/Widget.NHN.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_submit_request"
                android:textSize="16sp" />

            <!-- Submit Progress -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/colorAccent"
                app:trackColor="#E0E4F0" />

            <View android:layout_width="match_parent"
                android:layout_height="24dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
