<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Gradient Header Banner -->
        <View
            android:id="@+id/viewHeader"
            android:layout_width="0dp"
            android:layout_height="240dp"
            android:background="@drawable/gradient_header"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- App Logo / Icon -->
        <ImageView
            android:id="@+id/ivAppLogo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="28dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/viewHeader"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintBottom_toTopOf="@id/tvAppName" />

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="@color/colorTextOnDark"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivAppLogo" />

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.8"
            android:fontFamily="sans-serif"
            android:text="@string/app_tagline"
            android:textColor="@color/colorTextOnDark"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAppName" />

        <!-- Verification Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVerification"
            style="@style/Widget.NHN.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="-40dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/viewHeader">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <!-- Email Sent Icon / Illustration -->
                <ImageView
                    android:id="@+id/ivMailIcon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    android:src="@android:drawable/ic_dialog_email"
                    app:tint="@color/colorPrimary" />

                <!-- Title -->
                <TextView
                    android:id="@+id/tvVerificationTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_email_verification"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Description -->
                <TextView
                    android:id="@+id/tvVerificationDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/desc_email_verification"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.2"
                    android:gravity="center"
                    android:layout_marginBottom="28dp" />

                <!-- Check Verification Status Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckStatus"
                    style="@style/Widget.NHN.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/btn_check_verification_status"
                    android:textAllCaps="false"
                    android:textColor="@color/colorOnPrimary"
                    android:layout_marginBottom="12dp" />

                <!-- Resend Email Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResendEmail"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/btn_resend_verification_email"
                    android:textColor="@color/colorPrimary"
                    android:textAllCaps="false"
                    android:layout_marginBottom="12dp"
                    app:strokeColor="@color/colorPrimary" />

                <!-- Back / Logout Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackToLogin"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/btn_back_to_login"
                    android:textColor="@color/colorAccent"
                    android:textAllCaps="false" />

                <!-- Progress Indicator -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressVerification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/colorAccent"
                    app:trackColor="@color/colorDivider" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
